# Spotify API (server-side only)
SPOTIFY_CLIENT_ID="your_client_id"
SPOTIFY_CLIENT_SECRET="your_client_secret"
SPOTIFY_REFRESH_TOKEN="your_refresh_token"

# Legacy client-side env names still used by archived Gatsby reference code.
# Astro replacements will be introduced in the relevant migration phases.
GATSBY_FACEBOOK_APP_ID=your_app_id
GATSBY_SUPABASE_URL=https://your-project.supabase.co
GATSBY_SUPABASE_KEY=your_publishable_key
