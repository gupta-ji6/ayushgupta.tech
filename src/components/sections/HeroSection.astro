---
import { render } from 'astro:content';

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<section class="section-shell hero-shell">
  <div class="hero-stack">
    <p class="subtitle reveal-item" data-reveal style="--reveal-delay: 0ms;">
      {entry.data.title}
    </p>
    <h1
      class="big-heading reveal-item"
      data-reveal
      style="--reveal-delay: 100ms;"
    >
      {entry.data.name}
    </h1>
    <h2
      class="hero-subtitle reveal-item"
      data-reveal
      style="--reveal-delay: 200ms;"
    >
      {entry.data.subtitle}
    </h2>
    <div
      class="rich-text hero-copy reveal-item"
      data-reveal
      style="--reveal-delay: 300ms;"
    >
      <Content />
    </div>
    <div class="reveal-item" data-reveal style="--reveal-delay: 400ms;">
      <a href="/resume" class="button-link">
        {entry.data.contactText}
      </a>
    </div>
  </div>
</section>

<style>
  .hero-shell {
    min-height: calc(100vh - 100px);
    display: flex;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
  }

  .hero-stack {
    width: 100%;
    max-width: 1000px;
  }

  .hero-subtitle {
    margin: 0;
    color: var(--color-slate);
    font-size: clamp(30px, 7vw, 70px);
    line-height: 1.08;
  }

  .hero-copy {
    max-width: 540px;
    margin-top: 24px;
  }

  .hero-copy :global(p) {
    color: var(--color-light-slate);
    font-size: clamp(18px, 2.25vw, 22px);
    line-height: 1.55;
  }

  .hero-copy :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .hero-shell {
      min-height: auto;
      padding-top: 90px;
      padding-bottom: 30px;
    }
  }
</style>
