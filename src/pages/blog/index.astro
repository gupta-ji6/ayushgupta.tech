---
export const prerender = true;
import BaseLayout from '@layouts/BaseLayout.astro';
import AuthorCard from '@components/blog/AuthorCard.astro';
import PageReveal from '@components/PageReveal.astro';
import { getCollection } from 'astro:content';
import {
  formatBlogDate,
  getBlogPath,
  getPublishedBlogEntries,
  slugifyTag,
} from '@utils/blog';

const allPosts = await getCollection('blog');
const posts = getPublishedBlogEntries(allPosts);
---

<BaseLayout title="Blog" description="Articles, guides, and notes by Ayush Gupta.">
  <section class="blog-page">
    <header class="blog-header page-reveal">
      <h1 class="big-heading">thoughts</h1>
      <p class="subtitle">documenting my learning journey, failures &amp; wins</p>
    </header>

    <section class="blog-content page-reveal">
      <AuthorCard />

      <h2 class="medium-heading blog-latest-heading">Latest Articles</h2>

      <ol class="blog-list">
        {
          posts.map((entry) => (
            <li class="blog-list-item">
              <div class="blog-post-card">
                <header>
                  <h2 class="blog-post-title">
                    <a href={getBlogPath(entry)} class="inline-link">
                      {entry.data.title}
                    </a>
                  </h2>

                  <p class="blog-post-description">{entry.data.description}</p>
                </header>

                <footer class="blog-post-footer">
                  <span class="blog-post-date">
                    {formatBlogDate(entry.data.date)}
                  </span>

                  <ul class="blog-post-tags">
                    {entry.data.tags.map((tag: string) => (
                      <li>
                        <a
                          href={`/blog/tags/${slugifyTag(tag)}`}
                          class="inline-link"
                        >
                          #{tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                </footer>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </section>

  <PageReveal />
</BaseLayout>

<style>
  .blog-page {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding: 120px 0;
  }

  .blog-header {
    margin-bottom: 100px;
    text-align: center;
  }

  .blog-latest-heading {
    margin-top: 50px;
    text-align: center;
  }

  .blog-list {
    list-style: none;
    margin: 50px 0 0;
    padding: 0;
  }

  .blog-list-item {
    margin-bottom: 25px;
  }

  .blog-post-card {
    padding: 32px 28px;
    border-radius: 3px;
    background: var(--color-light-navy);
    box-shadow: 0 10px 30px -15px var(--color-shadow-navy);
    transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
  }

  .blog-post-card:hover,
  .blog-post-card:focus-within {
    box-shadow: 0 20px 30px -15px var(--color-shadow-navy);
    transform: translateY(-5px);
  }

  .blog-post-title {
    margin: 0 0 10px;
    font-size: clamp(28px, 4vw, 32px);
  }

  .blog-post-title a {
    color: var(--color-lightest-slate);
    transition: color 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
  }

  .blog-post-card:hover .blog-post-title a,
  .blog-post-card:focus-within .blog-post-title a {
    color: var(--color-green);
  }

  .blog-post-card:hover .blog-post-title a::after,
  .blog-post-card:focus-within .blog-post-title a::after {
    width: 100%;
  }

  .blog-post-description {
    margin: 0;
    color: var(--color-light-slate);
    font-size: 20px;
    line-height: 1.5;
  }

  .blog-post-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 20px;
  }

  .blog-post-date {
    padding: 10px 0;
    color: var(--color-light-slate);
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
  }

  .blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-post-tags li {
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.75;
  }

  .blog-post-tags li:not(:last-child) {
    margin-right: 15px;
  }

  @media (max-width: 768px) {
    .blog-page {
      padding: 100px 0;
    }
  }

  @media (max-width: 480px) {
    .blog-latest-heading {
      text-align: left;
    }
  }
</style>
