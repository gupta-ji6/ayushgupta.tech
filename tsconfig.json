{
  "extends": "astro/tsconfigs/strict",
  "include": ["src/**/*", "astro.config.mjs", "eslint.config.mjs"],
  "exclude": [
    "dist",
    ".astro",
    "node_modules",
    "public",
    "netlify",
    "docs",
    ".claude"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@config/*": ["src/config/*"],
      "@hooks/*": ["src/hooks/*"],
      "@images/*": ["src/images/*"],
      "@layouts/*": ["src/layouts/*"],
      "@styles/*": ["src/styles/*"],
      "@utils/*": ["src/utils/*"]
    },
    "jsx": "react-jsx"
  }
}
